Port of remote-android/redroid-modules (branch master, ashmem/) to Linux 6.8 for the test VM.
Apply in a redroid-modules checkout with: patch -p1 < ashmem-linux-6.8.patch
  * vm_flags is read-only since 6.3: use vm_flags_clear()
  * shrinker API changed in 6.7: shrinker_alloc()/shrinker_register()/shrinker_free()
  * kallsyms_lookup_name is unexported since 5.7: resolve it through a kprobe
Test infrastructure only - not part of the APK.

--- a/ashmem/ashmem.c
+++ b/ashmem/ashmem.c
@@ -402,7 +402,7 @@
 		ret = -EPERM;
 		goto out;
 	}
-	vma->vm_flags &= ~calc_vm_may_flags(~asma->prot_mask);
+	vm_flags_clear(vma, calc_vm_may_flags(~asma->prot_mask));
 
 	if (!asma->file) {
 		char *name = ASHMEM_NAME_DEF;
@@ -528,15 +528,7 @@
 	return lru_count;
 }
 
-static struct shrinker ashmem_shrinker = {
-	.count_objects = ashmem_shrink_count,
-	.scan_objects = ashmem_shrink_scan,
-	/*
-	 * XXX (dchinner): I wish people would comment on why they need on
-	 * significant changes to the default value here
-	 */
-	.seeks = DEFAULT_SEEKS * 4,
-};
+static struct shrinker *ashmem_shrinker;
 
 static int set_prot_mask(struct ashmem_area *asma, unsigned long prot)
 {
@@ -857,8 +849,8 @@
 				.gfp_mask = GFP_KERNEL,
 				.nr_to_scan = LONG_MAX,
 			};
-			ret = ashmem_shrink_count(&ashmem_shrinker, &sc);
-			ashmem_shrink_scan(&ashmem_shrinker, &sc);
+			ret = ashmem_shrink_count(ashmem_shrinker, &sc);
+			ashmem_shrink_scan(ashmem_shrinker, &sc);
 		}
 		break;
 	}
@@ -947,7 +939,15 @@
 		goto out_free2;
 	}
 
-	ret = register_shrinker(&ashmem_shrinker);
+	/* Linux >= 6.7 shrinker API (test-VM port) */
+	ashmem_shrinker = shrinker_alloc(0, "android-ashmem");
+	ret = ashmem_shrinker ? 0 : -ENOMEM;
+	if (ashmem_shrinker) {
+		ashmem_shrinker->count_objects = ashmem_shrink_count;
+		ashmem_shrinker->scan_objects = ashmem_shrink_scan;
+		ashmem_shrinker->seeks = DEFAULT_SEEKS * 4;
+		shrinker_register(ashmem_shrinker);
+	}
 	if (ret) {
 		pr_err("failed to register shrinker!\n");
 		goto out_demisc;
@@ -970,7 +970,7 @@
 // HACKED
 static void __exit ashmem_exit(void)
 {
-	unregister_shrinker(&ashmem_shrinker);
+	shrinker_free(ashmem_shrinker);
 
 	misc_deregister(&ashmem_misc);
 
--- a/ashmem/deps.c
+++ b/ashmem/deps.c
@@ -1,12 +1,25 @@
+// Test-VM port: kallsyms_lookup_name is not exported since Linux 5.7, so locate it via a kprobe.
 #include <linux/mm.h>
-#include <linux/kallsyms.h>
+#include <linux/kprobes.h>
 
+typedef unsigned long (*kallsyms_lookup_name_t)(const char *name);
 typedef int (*shmem_zero_setup_ptr_t)(struct vm_area_struct *);
 static shmem_zero_setup_ptr_t shmem_zero_setup_ptr = NULL;
+
+static unsigned long fc_lookup_name(const char *name)
+{
+	struct kprobe kp = { .symbol_name = "kallsyms_lookup_name" };
+	kallsyms_lookup_name_t fn;
+	if (register_kprobe(&kp) < 0)
+		return 0;
+	fn = (kallsyms_lookup_name_t) kp.addr;
+	unregister_kprobe(&kp);
+	return fn ? fn(name) : 0;
+}
+
 int shmem_zero_setup(struct vm_area_struct *vma)
 {
 	if (!shmem_zero_setup_ptr)
-		shmem_zero_setup_ptr = (shmem_zero_setup_ptr_t) kallsyms_lookup_name("shmem_zero_setup");
+		shmem_zero_setup_ptr = (shmem_zero_setup_ptr_t) fc_lookup_name("shmem_zero_setup");
 	return shmem_zero_setup_ptr(vma);
 }
